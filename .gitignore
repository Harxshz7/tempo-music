# Dependencies & Packages
node_modules/
*.tgz

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets
# The whole family is ignored, not just .env — .env.production leaks
# just as often. Templates stay committed so onboarding is copy-paste.
.env
.env.*
!.env.example
!.env.*.example

# Keys, Certificates & Provisioning Profiles
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.key
*.pem
*.mobileprovision

# Expo, EAS & Metro
.expo/
dist/
web-build/
.eas/
expo-env.d.ts
.metro-health-check*

# Generated Native Projects (expo prebuild output — regenerate, never commit)
/ios/
/android/
.kotlin/

# Caches & Build Artifacts
node_modules/.cache/
*.tsbuildinfo
*.tmp

# Testing & Coverage
coverage/
.nyc_output/

# Merge Conflict Leftovers
*.orig
*.orig.*
*.rej

# IDEs, Editors & AI Tooling
.vscode/
.idea/
